# CyberSecurity Risk Detector - Environment Configuration Template
# Copy this file to .env and customize for your local setup

# Flask Application
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-to-a-secure-random-secret-key-in-production
PORT=5001

# JWT Settings
JWT_SECRET_KEY=change-to-a-secure-jwt-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Database
# Uses MongoDB by default, falls back to SQLite automatically if MongoDB is unreachable
MONGO_URI=mongodb://localhost:27017/cybersecurity_db
DB_NAME=cybersecurity_db
SQLITE_PATH=cybersecurity.db

# File Upload Limits
MAX_CONTENT_LENGTH_MB=25
MAX_CSV_ROWS=100000
ALLOWED_EXTENSIONS=csv

# ML Defaults
DEFAULT_CONTAMINATION=0.08
RANDOM_STATE=42

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
